{
  "name": "@mediaflow/design",
  "version": "1.0.0",
  "description": "Mediaflow corporate design on Beautiful UI: tokens, Tailwind 4 theme, shared classes and components for Mediaflow's internal Next.js apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./primitives/*": "./src/primitives/*.tsx",
    "./css": "./css/index.css",
    "./css/*": "./css/*"
  },
  "files": [
    "css",
    "src",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "shadow-plugin": "^2.1.1"
  },
  "peerDependencies": {
    "class-variance-authority": ">=0.7",
    "clsx": ">=2",
    "lucide-react": ">=0.400",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwind-merge": ">=3",
    "tailwindcss": ">=4.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.9.3"
  }
}
